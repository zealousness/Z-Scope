{
  "project_name": "Z-Scope Test Demo",
  "version": "2.0.0",
  "description": "Tiered test cases for Z-Scope defect detection validation.",
  "tiers": [
    {
      "level": "Junior",
      "description": "Easy to find defects for quick validation (Basic memory/resource safety).",
      "modules": [
        {
          "name": "cache_module",
          "path": "test/junior/cache_module",
          "defects": [
            {
              "id": "J-MEM-001",
              "type": "Stack Memory Return",
              "file": "src/cache_queue.c",
              "function": "lru_remove_lru()",
              "description": "Uses static buffer (pattern shows stack memory return risk)",
              "impact": "Potential dangling pointer if not static"
            },
            {
              "id": "J-BUF-001",
              "type": "Buffer Overflow",
              "file": "src/cache_core.c",
              "line": 165,
              "function": "cache_get()",
              "description": "memcpy(value_out, node->value, node->value_size) without checking buffer_size",
              "impact": "Heap corruption if caller provides undersized buffer"
            },
            {
              "id": "J-MEM-002",
              "type": "Memory Leak",
              "file": "src/cache_index.c",
              "function": "avl_create_node()",
              "description": "If malloc(value) fails, node is leaked",
              "impact": "Gradual memory leak"
            },
            {
              "id": "J-MEM-003",
              "type": "Memory Leak",
              "file": "src/cache_index.c",
              "function": "avl_insert()",
              "description": "On key update, old value not freed before overwrite",
              "impact": "Gradual memory leak on repeated updates"
            },
            {
              "id": "J-RES-001",
              "type": "File Descriptor Leak",
              "file": "src/cache_storage.c",
              "function": "storage_save_cache()",
              "description": "3 error paths don't call close(fd)",
              "impact": "FD exhaustion"
            },
            {
              "id": "J-RES-002",
              "type": "File Descriptor Leak",
              "file": "src/cache_storage.c",
              "function": "storage_load_cache()",
              "description": "malloc failure path doesn't close fd",
              "impact": "FD exhaustion"
            },
            {
              "id": "J-OOB-001",
              "type": "Untrusted Index",
              "file": "src/cache_core.c",
              "line": 293,
              "function": "cache_clear()",
              "description": "Uses count from tree traversal directly in loop without validation (~10000 limit)",
              "impact": "Stack buffer overflow"
            },
            {
              "id": "J-MEM-004",
              "type": "Memory Accumulation",
              "file": "src/cache_queue.c",
              "function": "lru_remove_node_buggy()",
              "description": "Function updates pointers but doesn't free() the nodes",
              "impact": "Orphaned memory leak"
            }
          ]
        }
      ]
    }
  ]
}
