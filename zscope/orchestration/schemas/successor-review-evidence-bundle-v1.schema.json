{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/successor-review-evidence-bundle-v1.schema.json",
  "title": "Physical current-successor independent-review evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "workflow_path",
    "workflow_event",
    "workflow_branch",
    "workflow_run_id",
    "workflow_run_attempt",
    "control_plane_commit",
    "candidate_git_sha",
    "candidate_git_tree",
    "implementation_root_sha256",
    "successor_qualification_sha256",
    "artifact_metadata",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.successor-review-evidence-bundle.v1"},
    "repository": {"const": "zealousness/Z-Scope"},
    "workflow_path": {"const": ".github/workflows/p6-pilot-validation.yml"},
    "workflow_event": {"const": "workflow_dispatch"},
    "workflow_branch": {"const": "main"},
    "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "workflow_run_attempt": {"type": "integer", "minimum": 1},
    "control_plane_commit": {"$ref": "#/$defs/gitObject"},
    "candidate_git_sha": {"$ref": "#/$defs/gitObject"},
    "candidate_git_tree": {"$ref": "#/$defs/gitObject"},
    "implementation_root_sha256": {"$ref": "#/$defs/sha256"},
    "successor_qualification_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification",
        "product_architecture",
        "proof_security",
        "independent_benchmark",
        "final_evidence"
      ],
      "properties": {
        "qualification": {"$ref": "#/$defs/artifact"},
        "product_architecture": {"$ref": "#/$defs/artifact"},
        "proof_security": {"$ref": "#/$defs/artifact"},
        "independent_benchmark": {"$ref": "#/$defs/artifact"},
        "final_evidence": {"$ref": "#/$defs/artifact"}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflow_path",
        "workflow_event",
        "workflow_branch",
        "workflow_run_id",
        "workflow_run_attempt",
        "head_sha",
        "producer_job",
        "artifact_id",
        "artifact_name",
        "artifact_sha256",
        "expired",
        "restore_receipt_sha256"
      ],
      "properties": {
        "repository": {"const": "zealousness/Z-Scope"},
        "workflow_path": {"const": ".github/workflows/p6-pilot-validation.yml"},
        "workflow_event": {"const": "workflow_dispatch"},
        "workflow_branch": {"const": "main"},
        "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "workflow_run_attempt": {"type": "integer", "minimum": 1},
        "head_sha": {"$ref": "#/$defs/gitObject"},
        "producer_job": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "integer", "minimum": 1},
        "artifact_name": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "expired": {"const": false},
        "restore_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$comment": "Cross-artifact ID/digest uniqueness and exact producer/name/run equality are relational constraints enforced by successor_review_evidence.py."
}
