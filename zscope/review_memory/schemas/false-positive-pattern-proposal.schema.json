{
  "$id": "zscope.false-positive-pattern-proposal.v1",
  "type": "object",
  "required": ["schema_version", "pattern_id", "project_id", "scope", "trigger_features", "status"],
  "properties": {
    "schema_version": {"const": "zscope.false-positive-pattern-proposal.v1"},
    "pattern_id": {"type": "string", "minLength": 1},
    "review_subject_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "trigger_features": {"type": "array", "items": {"type": "object"}},
    "match_contract": {
      "type": "object",
      "required": ["schema_version", "groups"],
      "properties": {
        "schema_version": {"const": "zscope.candidate-stable-fields.v1"},
        "groups": {"type": "array", "items": {"type": "object", "required": ["all"], "properties": {
          "all": {"type": "array", "items": {"type": "object", "required": ["path", "value"], "properties": {
            "path": {"type": "string"}, "operator": {"enum": ["eq", "contains"]}, "value": {}
          }, "additionalProperties": false}}
        }, "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    "contract_digest": {"type": "string"},
    "false_positive_reason": {"type": "string"},
    "required_checks": {"type": "array", "items": {"type": "string"}},
    "counter_conditions": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "source_fingerprints": {"type": "array", "items": {"type": "string"}},
    "origin_review_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string"}
  },
  "additionalProperties": true
}
