{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/p6_final_evidence_manifest.schema.json",
  "title": "Z-SCOPE P6 complete non-release evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "control_plane_commit", "candidate_git_sha",
    "workflow_run_id", "workflow_run_attempt", "attempt_id", "artifacts",
    "phase_status", "formal_benchmark", "release_eligible", "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.p6-final-evidence-manifest.v1"},
    "control_plane_commit": {"$ref": "#/$defs/gitObject"},
    "candidate_git_sha": {"$ref": "#/$defs/gitObject"},
    "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "workflow_run_attempt": {"type": "integer", "minimum": 1},
    "attempt_id": {
      "type": "string",
      "pattern": "^p6-[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\\\u0000]+$"
          },
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "phase_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry", "provider_probe", "toolchain_oci_preflight", "policy_replay",
        "certificate_reverify", "anonymous_qualification", "safe_pair_validation",
        "evidence_action_canary", "cold_fast", "cold_balanced",
        "balanced_quality_gate", "cold_deep", "conservation", "qualification_seal",
        "product_architecture_review", "proof_security_review",
        "independent_benchmark_review", "final_evidence_seal"
      ],
      "properties": {
        "entry": {"const": "completed"},
        "provider_probe": {"const": "completed"},
        "toolchain_oci_preflight": {"const": "completed"},
        "policy_replay": {"const": "completed"},
        "certificate_reverify": {"const": "completed"},
        "anonymous_qualification": {"const": "completed"},
        "safe_pair_validation": {"const": "completed"},
        "evidence_action_canary": {"const": "completed"},
        "cold_fast": {"const": "completed"},
        "cold_balanced": {"const": "completed"},
        "balanced_quality_gate": {"const": "completed"},
        "cold_deep": {"const": "completed"},
        "conservation": {"const": "completed"},
        "qualification_seal": {"const": "completed"},
        "product_architecture_review": {"const": "completed"},
        "proof_security_review": {"const": "completed"},
        "independent_benchmark_review": {"const": "completed"},
        "final_evidence_seal": {"const": "completed"}
      }
    },
    "formal_benchmark": {"const": false},
    "release_eligible": {"const": false},
    "evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
