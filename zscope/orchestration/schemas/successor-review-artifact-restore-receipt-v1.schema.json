{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/successor-review-artifact-restore-receipt-v1.schema.json",
  "title": "Exact restored P6 producer artifact receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "repository", "workflow_path", "workflow_event",
    "workflow_branch", "workflow_run_id", "workflow_run_attempt", "head_sha",
    "producer_job", "artifact_id", "artifact_name", "artifact_sha256", "expired",
    "restored_tree_sha256", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.successor-review-artifact-restore-receipt.v1"},
    "repository": {"const": "zealousness/Z-Scope"},
    "workflow_path": {"const": ".github/workflows/p6-pilot-validation.yml"},
    "workflow_event": {"const": "workflow_dispatch"},
    "workflow_branch": {"const": "main"},
    "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "workflow_run_attempt": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "producer_job": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "integer", "minimum": 1},
    "artifact_name": {"type": "string", "minLength": 1},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "expired": {"const": false},
    "restored_tree_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
