{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/function-security-summary-v2.schema.json",
  "title": "FunctionSecuritySummary v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_revision", "summary_uid", "function_uid", "signature",
    "file", "entry_node_uid", "exit_node_uids", "cfg_nodes", "cfg_edges", "events",
    "type_layouts", "wrapper_summaries", "coverage", "code_sha256", "backend_sha256",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.function-security-summary.v2"},
    "protocol_revision": {"const": 2},
    "summary_uid": {"type": "string", "pattern": "^FUNSUM_[0-9a-f]{32}$"},
    "function_uid": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1},
    "file": {"type": "string", "minLength": 1},
    "entry_node_uid": {"type": "string", "minLength": 1},
    "exit_node_uids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "cfg_nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_uid", "statement_uids"],
        "properties": {
          "node_uid": {"type": "string", "minLength": 1},
          "statement_uids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "cfg_edges": {
      "type": "array",
      "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2},
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_uid", "node_uid", "statement_uid", "kind", "subject_uids", "attributes"],
        "properties": {
          "event_uid": {"type": "string", "minLength": 1},
          "node_uid": {"type": "string", "minLength": 1},
          "statement_uid": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "subject_uids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "attributes": {"type": "object"}
        }
      }
    },
    "type_layouts": {"type": "array", "items": {"type": "object"}},
    "wrapper_summaries": {"type": "array", "items": {"type": "object"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "code_sha256": {"$ref": "#/$defs/sha256"},
    "backend_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "unresolved_reasons"],
      "properties": {
        "complete": {"type": "boolean"},
        "unresolved_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
