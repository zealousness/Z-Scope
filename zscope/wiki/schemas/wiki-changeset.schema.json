{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zscope.wiki-changeset.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workset_id",
    "base_revision_id",
    "outcome",
    "source_results",
    "page_changes",
    "constraint_proposals",
    "edge_proposals",
    "retire_proposals",
    "unresolved_conflicts",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "zscope.wiki-changeset.v1"
    },
    "workset_id": {
      "type": "string",
      "pattern": "^workset_[a-z0-9_:-]+$"
    },
    "base_revision_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^wikirev_[a-z0-9_:-]+$"
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "prompt_version"],
      "properties": {
        "kind": {"type": "string", "enum": ["deterministic", "llm", "mixed"]},
        "identity": {"type": "string", "minLength": 1, "maxLength": 240},
        "prompt_version": {"type": ["string", "null"], "maxLength": 120},
        "model": {"type": ["string", "null"], "maxLength": 160}
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "changed",
        "background_only",
        "conflict_only",
        "extraction_failed",
        "source_rejected"
      ]
    },
    "source_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "extraction_status",
          "source_refs_used",
          "constraint_ids",
          "reason"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "pattern": "^(docsrc|docdesc)_[a-z0-9_:-]+$"
          },
          "extraction_status": {
            "type": "string",
            "enum": [
              "constraints_found",
              "no_constraints_found",
              "background_page_updated",
              "conflict_detected",
              "extraction_failed",
              "source_rejected"
            ]
          },
          "source_refs_used": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^docref_[a-z0-9_:-]+$"
            }
          },
          "constraint_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^constraint_[a-z0-9_:-]+$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "page_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "page_id",
          "source_refs_used"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "upsert",
              "retire"
            ]
          },
          "page_id": {
            "type": "string",
            "pattern": "^page_[a-z0-9_:-]+$"
          },
          "markdown": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000000
          },
          "source_refs_used": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^docref_[a-z0-9_:-]+$"
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "constraint_proposals": {
      "type": "array",
      "items": {
        "$ref": "zscope.project-constraint.v1"
      }
    },
    "edge_proposals": {
      "type": "array",
      "items": {
        "$ref": "zscope.wiki-edge.v1"
      }
    },
    "retire_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_type",
          "object_id",
          "reason"
        ],
        "properties": {
          "object_type": {
            "type": "string",
            "enum": [
              "page",
              "constraint",
              "edge"
            ]
          },
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "unresolved_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "constraint_ids",
          "reason"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "constraint_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^constraint_[a-z0-9_:-]+$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
