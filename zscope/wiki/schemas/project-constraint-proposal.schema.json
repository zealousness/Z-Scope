{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zscope.project-constraint-proposal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "subject_kind",
    "kind",
    "statement",
    "normativity",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "zscope.project-constraint-proposal.v1"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "subject_kind": {
      "type": "string",
      "enum": [
        "project",
        "module",
        "api",
        "symbol",
        "resource",
        "lock",
        "type",
        "configuration",
        "topic"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "module_boundary",
        "public_api",
        "entry_exposure",
        "input_range",
        "input_format",
        "caller_precondition",
        "return_contract",
        "error_contract",
        "nullability",
        "size_contract",
        "ownership_acquire",
        "ownership_release",
        "ownership_transfer",
        "resource_lifecycle",
        "requires_lock",
        "protects_state",
        "lock_order",
        "threading_contract",
        "configuration_constraint",
        "sanitizer_or_guard",
        "documented_exception",
        "known_false_positive_pattern"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "normativity": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "descriptive",
        "unknown"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^docref_[a-z0-9_:-]+$"
      }
    }
  }
}
