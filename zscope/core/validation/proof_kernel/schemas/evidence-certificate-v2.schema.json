{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/evidence-certificate-v2.schema.json",
  "title": "EvidenceCertificate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_revision", "certificate_uid", "action_uid", "obligation_uid",
    "clause_uid", "proof_ir_uid", "provider_family", "provider_id", "provider_version",
    "verifier_id", "predicate_id", "fact_kind", "status", "predicate_polarity",
    "quantifier", "subject_uid", "decision_region_uid", "predicate_value", "witness",
    "coverage", "assumption_ids", "code_sha256", "ir_sha256", "backend_sha256",
    "dependency_hashes", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.evidence-certificate.v2"},
    "protocol_revision": {"const": 2},
    "certificate_uid": {"type": "string", "pattern": "^CERT_[0-9a-f]{32}$"},
    "action_uid": {"type": "string", "pattern": "^EVACTION_[0-9a-f]{32}$"},
    "obligation_uid": {"type": "string", "pattern": "^POBL_[0-9a-f]{32}$"},
    "clause_uid": {"type": "string", "pattern": "^PCLAUSE_[0-9a-f]{32}$"},
    "proof_ir_uid": {"type": "string", "pattern": "^PROOFIR_[0-9a-f]{32}$"},
    "provider_family": {"enum": ["concurrency", "resource", "path_guard", "contract_type"]},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_version": {"type": "string", "minLength": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "predicate_id": {"type": "string", "minLength": 1},
    "fact_kind": {"type": "string", "minLength": 1},
    "status": {"enum": ["verified_true", "verified_false", "unknown", "conflicting"]},
    "predicate_polarity": {"enum": ["supports", "refutes"]},
    "quantifier": {"enum": ["must_at_point", "for_all_exits", "exists_path", "for_all_paths", "exact_binding", "exact_layout"]},
    "subject_uid": {"type": "string", "minLength": 1},
    "decision_region_uid": {"type": "string", "minLength": 1},
    "predicate_value": {},
    "witness": {
      "type": "object", "additionalProperties": false,
      "required": ["cfg_nodes", "cfg_edges", "path_node_uids", "exit_node_uids", "values"],
      "properties": {
        "cfg_nodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "cfg_edges": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2}, "uniqueItems": true},
        "path_node_uids": {"type": "array", "items": {"type": "string"}},
        "exit_node_uids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "values": {"type": "object"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "enumerated_uids", "required_uids", "complete", "unresolved_reasons"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "enumerated_uids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_uids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "complete": {"type": "boolean"},
        "unresolved_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "assumption_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}, "uniqueItems": true},
    "code_sha256": {"$ref": "#/$defs/sha256"},
    "ir_sha256": {"$ref": "#/$defs/sha256"},
    "backend_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_hashes": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "minItems": 1, "uniqueItems": true},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
