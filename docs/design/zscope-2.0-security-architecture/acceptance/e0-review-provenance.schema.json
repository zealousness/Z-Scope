{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/range-v16-review-provenance.v1.json",
  "title": "Range v16 protected review provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_path",
    "workflow_run_id",
    "head_sha",
    "environment",
    "artifact_name",
    "artifact_digest",
    "packet_catalog_sha256",
    "review_bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "zscope.range-v16-review-provenance.v1"
    },
    "workflow_path": {
      "const": ".github/workflows/range-v16-review.yml"
    },
    "workflow_run_id": {
      "type": "integer",
      "minimum": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment": {
      "const": "sealed-benchmark"
    },
    "artifact_name": {
      "type": "string",
      "pattern": "^range-v16-reviewed-[0-9a-f]{40}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "packet_catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
