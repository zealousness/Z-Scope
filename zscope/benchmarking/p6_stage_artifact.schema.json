{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/p6-stage-artifact-v1.json",
  "title": "Z-SCOPE P6 typed stage artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_path",
    "workflow_run_id",
    "workflow_run_attempt",
    "attempt_id",
    "control_plane_commit",
    "stage",
    "candidate_sha256",
    "policy_sha256",
    "plan_sha256",
    "input_sha256",
    "runtime_sha256",
    "provider_sha256",
    "oci_sha256",
    "cold_cache_identities_sha256",
    "binding_sha256",
    "payload_sha256",
    "formal_evidence",
    "release_eligible"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "zscope.p6-stage-artifact.v1"
    },
    "workflow_path": {
      "type": "string",
      "const": ".github/workflows/p6-pilot-validation.yml"
    },
    "workflow_run_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "workflow_run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^p6-[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "control_plane_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "stage": {
      "$ref": "#/$defs/stage"
    },
    "candidate_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "oci_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cold_cache_identities_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "binding_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "formal_evidence": {
      "type": "boolean",
      "const": false
    },
    "release_eligible": {
      "type": "boolean",
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "entry",
        "provider_probe",
        "toolchain_oci_preflight",
        "policy_replay",
        "certificate_reverify",
        "anonymous_qualification",
        "safe_pair_validation",
        "evidence_action_canary",
        "cold_fast",
        "cold_balanced",
        "cold_deep",
        "conservation",
        "qualification_seal",
        "product_architecture_review",
        "proof_security_review",
        "independent_benchmark_review",
        "final_evidence_seal"
      ]
    }
  }
}
