{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/hypothesis-hunt-report-v2.schema.json",
  "title": "HypothesisHuntReport v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_unit_uid",
    "unit_fingerprint_sha256",
    "coverage_status",
    "selected_offers",
    "reviewed_evidence_refs",
    "unresolved_reasons"
  ],
  "properties": {
    "schema_version": {"const": "zscope.hypothesis-hunt-report.v2"},
    "audit_unit_uid": {"type": "string", "pattern": "^HAU_[0-9a-f]{32}$"},
    "unit_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage_status": {"enum": ["complete", "partial", "failed"]},
    "selected_offers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offer_uid",
          "evidence_action_uids",
          "supporting_fact_refs",
          "opposing_fact_refs",
          "unknown_fact_refs",
          "evidence_refs"
        ],
        "properties": {
          "offer_uid": {"type": "string", "pattern": "^HOFFER_[0-9a-f]{32}$"},
          "evidence_action_uids": {"$ref": "#/$defs/stringSet"},
          "supporting_fact_refs": {"$ref": "#/$defs/stringSet"},
          "opposing_fact_refs": {"$ref": "#/$defs/stringSet"},
          "unknown_fact_refs": {"$ref": "#/$defs/stringSet"},
          "evidence_refs": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"minItems": 1}]}
        }
      }
    },
    "reviewed_evidence_refs": {"$ref": "#/$defs/stringSet"},
    "unresolved_reasons": {"$ref": "#/$defs/stringSet"}
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
