{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/p6_toolchain_oci_evidence.schema.json",
  "title": "Z-SCOPE P6 toolchain and OCI evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_path",
    "workflow_run_id",
    "workflow_run_attempt",
    "attempt_id",
    "control_plane_commit",
    "candidate_sha256",
    "candidate_git_sha",
    "candidate_git_tree",
    "image_ref",
    "image_digest",
    "image_id",
    "image_provenance_sha256",
    "image_provenance_content_sha256",
    "proxy_provision_sha256",
    "proxy_provision_content_sha256",
    "runtime_source_sha256",
    "oci_execution_sha256",
    "rootless_verified",
    "image_digest_verified",
    "mounts_verified",
    "network_restriction_verified",
    "runtime_source_mounted",
    "formal_evidence",
    "release_eligible",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.p6-toolchain-oci-evidence.v1"},
    "workflow_path": {"const": ".github/workflows/p6-pilot-validation.yml"},
    "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "workflow_run_attempt": {"type": "integer", "minimum": 1},
    "attempt_id": {"type": "string", "pattern": "^p6-[a-z0-9][a-z0-9._-]{2,127}$"},
    "control_plane_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_git_sha": {"$ref": "#/$defs/gitObject"},
    "candidate_git_tree": {"$ref": "#/$defs/gitObject"},
    "image_ref": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "image_id": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "image_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "image_provenance_content_sha256": {"$ref": "#/$defs/sha256"},
    "proxy_provision_sha256": {"$ref": "#/$defs/sha256"},
    "proxy_provision_content_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_source_sha256": {"$ref": "#/$defs/sha256"},
    "oci_execution_sha256": {"$ref": "#/$defs/sha256"},
    "rootless_verified": {"const": true},
    "image_digest_verified": {"const": true},
    "mounts_verified": {"const": true},
    "network_restriction_verified": {"const": true},
    "runtime_source_mounted": {"const": true},
    "formal_evidence": {"const": false},
    "release_eligible": {"const": false},
    "evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
