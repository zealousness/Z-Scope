{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/security-hypothesis-v2.schema.json",
  "title": "SecurityHypothesis v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_revision",
    "hypothesis_uid",
    "audit_unit_uid",
    "offer_uid",
    "defect_family",
    "subject_uid",
    "decision_region_uid",
    "location",
    "source_ref",
    "sink_ref",
    "resource_ref",
    "confirmation_clauses",
    "counterproof_clauses",
    "open_clauses",
    "supporting_fact_refs",
    "opposing_fact_refs",
    "unknown_fact_refs",
    "evidence_action_uids",
    "evidence_refs",
    "dependency_hashes",
    "origin",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.security-hypothesis.v2"},
    "protocol_revision": {"const": 2},
    "hypothesis_uid": {"type": "string", "pattern": "^HYP_[0-9a-f]{32}$"},
    "audit_unit_uid": {"type": "string", "pattern": "^HAU_[0-9a-f]{32}$"},
    "offer_uid": {"type": "string", "pattern": "^HOFFER_[0-9a-f]{32}$"},
    "defect_family": {"type": "string", "minLength": 1},
    "subject_uid": {"type": "string", "minLength": 1},
    "decision_region_uid": {"type": "string", "minLength": 1},
    "location": {"$ref": "hypothesis-offer-v2.schema.json#/$defs/location"},
    "source_ref": {"type": ["string", "null"]},
    "sink_ref": {"type": ["string", "null"]},
    "resource_ref": {"type": ["string", "null"]},
    "confirmation_clauses": {"type": "array", "items": {"type": "object"}},
    "counterproof_clauses": {"type": "array", "items": {"type": "object"}},
    "open_clauses": {"type": "array", "items": {"type": "object"}},
    "supporting_fact_refs": {"$ref": "#/$defs/stringSet"},
    "opposing_fact_refs": {"$ref": "#/$defs/stringSet"},
    "unknown_fact_refs": {"$ref": "#/$defs/stringSet"},
    "evidence_action_uids": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"minItems": 1}]},
    "evidence_refs": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"minItems": 1}]},
    "dependency_hashes": {"$ref": "#/$defs/hashSet"},
    "origin": {"const": "hypothesis_hunter"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hashSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
