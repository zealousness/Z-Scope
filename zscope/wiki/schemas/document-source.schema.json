{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zscope.document-source.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "project_id",
    "source_kind",
    "relative_path",
    "content_digest",
    "size_bytes",
    "classification",
    "classification_reason",
    "input_language",
    "module_hints",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "zscope.document-source.v1"
    },
    "source_id": {
      "type": "string",
      "pattern": "^docsrc_[a-z0-9_:-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "source_kind": {
      "const": "markdown_document"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?:[^/]+/)*[^/]+$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "classification": {
      "const": "explanatory"
    },
    "classification_reason": {
      "type": "string",
      "enum": [
        "explicit_project_readme",
        "explicit_document_contract",
        "explanatory_path_contract",
        "explanatory_override",
        "content_explanatory_threshold"
      ]
    },
    "input_language": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en",
        "mixed",
        "unknown"
      ]
    },
    "module_hints": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^module:[a-z0-9_.:/-]+$"
      }
    },
    "frontmatter": {
      "type": "object",
      "additionalProperties": true,
      "maxProperties": 64
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
