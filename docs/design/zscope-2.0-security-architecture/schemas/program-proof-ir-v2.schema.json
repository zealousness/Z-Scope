{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/program-proof-ir-v2.schema.json",
  "title": "ProgramProofIR v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_revision", "proof_ir_uid", "language", "project_uid",
    "revision_uid", "functions", "dependency_hashes", "coverage", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.program-proof-ir.v2"},
    "protocol_revision": {"const": 2},
    "proof_ir_uid": {"type": "string", "pattern": "^PROOFIR_[0-9a-f]{32}$"},
    "language": {"enum": ["c_cpp", "java"]},
    "project_uid": {"type": "string", "minLength": 1},
    "revision_uid": {"type": "string", "minLength": 1},
    "functions": {"type": "array", "minItems": 1, "items": {"$ref": "function-security-summary-v2.schema.json"}},
    "dependency_hashes": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "minItems": 1, "uniqueItems": true},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "unresolved_reasons"],
      "properties": {
        "complete": {"type": "boolean"},
        "unresolved_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
