{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/p6-checkpoint-v1.json",
  "title": "Z-SCOPE P6 non-formal checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_path",
    "workflow_run_id",
    "workflow_run_attempt",
    "attempt_id",
    "control_plane_commit",
    "status",
    "completed_stages",
    "stage_artifacts",
    "candidate_sha256",
    "policy_sha256",
    "plan_sha256",
    "input_sha256",
    "runtime_sha256",
    "provider_sha256",
    "oci_sha256",
    "artifact_root_sha256",
    "cold_cache_identities",
    "formal_evidence",
    "release_eligible",
    "requires_full_revalidation",
    "zero_call_finalizable"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "zscope.p6-checkpoint.v1"
    },
    "workflow_path": {
      "type": "string",
      "const": ".github/workflows/p6-pilot-validation.yml"
    },
    "workflow_run_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "workflow_run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^p6-[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "control_plane_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": [
        "partial",
        "complete"
      ]
    },
    "completed_stages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/execution_stage"
      }
    },
    "stage_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "producer_attempt_id",
          "path",
          "artifact_sha256",
          "artifact_schema_version",
          "binding_sha256"
        ],
        "properties": {
          "stage": {
            "$ref": "#/$defs/execution_stage"
          },
          "producer_attempt_id": {
            "type": "string",
            "pattern": "^p6-[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.json$"
          },
          "artifact_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "artifact_schema_version": {
            "type": "string",
            "const": "zscope.p6-stage-artifact.v1"
          },
          "binding_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "candidate_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "oci_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifact_root_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cold_cache_identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast",
        "balanced",
        "deep"
      ],
      "properties": {
        "fast": {
          "$ref": "#/$defs/cold_cache"
        },
        "balanced": {
          "$ref": "#/$defs/cold_cache"
        },
        "deep": {
          "$ref": "#/$defs/cold_cache"
        }
      }
    },
    "formal_evidence": {
      "type": "boolean",
      "const": false
    },
    "release_eligible": {
      "type": "boolean",
      "const": false
    },
    "requires_full_revalidation": {
      "type": "boolean",
      "const": true
    },
    "zero_call_finalizable": {
      "type": "boolean"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_stage": {
      "type": "string",
      "enum": [
        "entry",
        "provider_probe",
        "toolchain_oci_preflight",
        "policy_replay",
        "certificate_reverify",
        "anonymous_qualification",
        "safe_pair_validation",
        "evidence_action_canary",
        "cold_fast",
        "cold_balanced",
        "cold_deep",
        "conservation",
        "qualification_seal",
        "product_architecture_review",
        "proof_security_review",
        "independent_benchmark_review",
        "final_evidence_seal"
      ]
    },
    "cold_cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_sha256",
        "empty_at_start",
        "reused"
      ],
      "properties": {
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "empty_at_start": {
          "type": "boolean",
          "const": true
        },
        "reused": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
