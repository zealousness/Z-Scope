{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/e0-review-packet.v1.json",
  "title": "Z-SCOPE E0 minimal truth review packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_uid",
    "source_truth_sha256",
    "truth_record",
    "code_windows",
    "threat_assumptions",
    "safe_pair_candidate",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.range-v16-review-packet.v1"},
    "packet_uid": {"type": "string", "pattern": "^range-v16:[A-Za-z0-9_.:-]+$"},
    "source_truth_sha256": {"$ref": "#/$defs/sha256"},
    "truth_record": {"type": "object", "minProperties": 1},
    "code_windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "start_line", "end_line", "content", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "content": {"type": "string"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "threat_assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "safe_pair_candidate": {"type": "object"},
    "packet_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
