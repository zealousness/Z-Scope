{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/security-spec-qualification-v1.schema.json",
  "title": "SecuritySpecQualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_revision", "qualification_uid", "registry_sha256", "compiler_sha256", "corpus_sha256", "qualified_predicates", "source_projects", "metrics", "environment", "content_sha256"],
  "properties": {
    "schema_version": {"const": "zscope.security-spec-qualification.v1"},
    "protocol_revision": {"const": 2},
    "qualification_uid": {"type": "string", "pattern": "^SPECQUAL_[0-9a-f]{32}$"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "qualified_predicates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_projects": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["case_count", "key_contract_recall", "positive_unsupported_rate", "safe_false_activation_count", "evidence_resolution_rate", "second_scan_llm_reduction"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 120},
        "key_contract_recall": {"type": "number", "minimum": 0.85, "maximum": 1},
        "positive_unsupported_rate": {"type": "number", "minimum": 0, "maximum": 0.05},
        "safe_false_activation_count": {"const": 0},
        "evidence_resolution_rate": {"const": 1.0},
        "second_scan_llm_reduction": {"type": "number", "minimum": 0.8, "maximum": 1}
      }
    },
    "environment": {"type": "object"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
