{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/p6-review-decision-v1.json",
  "title": "Z-SCOPE P6 independent review decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_uid",
    "packet_sha256",
    "qualification_sha256",
    "evidence_root_sha256",
    "role",
    "harness",
    "harness_version",
    "provider",
    "model",
    "reasoning_effort",
    "decision",
    "blocker_count",
    "blockers",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "zscope.p6-review-decision.v1"
    },
    "packet_uid": {
      "type": "string",
      "pattern": "^p6-review:[a-z_]+:[0-9a-f]{64}$"
    },
    "packet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "qualification_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_root_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "role": {
      "enum": [
        "product_architecture",
        "proof_security",
        "independent_benchmark"
      ]
    },
    "harness": {
      "enum": [
        "claude-code",
        "dsh",
        "codex-cli"
      ]
    },
    "harness_version": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_effort": {
      "enum": [
        "high",
        "max",
        "xhigh"
      ]
    },
    "decision": {
      "enum": [
        "approved",
        "changes_required"
      ]
    },
    "blocker_count": {
      "type": "integer",
      "minimum": 0
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "artifact_sha256"
        ],
        "properties": {
          "code": {
            "enum": [
              "reviewer_binding_invalid",
              "architecture_contract_violation",
              "proof_soundness_violation",
              "benchmark_protocol_violation",
              "evidence_incomplete"
            ]
          },
          "artifact_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result",
          "artifact_sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          },
          "result": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "artifact_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
