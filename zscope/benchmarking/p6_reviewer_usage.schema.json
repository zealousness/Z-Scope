{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/p6_reviewer_usage.schema.json",
  "title": "Z-SCOPE P6 independent reviewer answer-free provider usage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role", "provider", "requested_model",
    "reviewer_identity_sha256", "packet_sha256", "decision_sha256",
    "evidence_root_sha256", "calls", "physical_call_count",
    "provider_reported_call_count", "missing_usage_call_count",
    "mismatched_model_call_count", "estimated_call_count",
    "provider_usage_coverage", "prompt_token_count", "completion_token_count",
    "total_token_count", "attribution_counts", "call_conservation_passed",
    "token_conservation_passed", "included_in_balanced_scan_token_gate",
    "reviewer_usage_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.p6-reviewer-usage.v1"},
    "role": {
      "enum": ["product_architecture", "proof_security", "independent_benchmark"]
    },
    "provider": {"enum": ["claude-code", "deepseek", "openai"]},
    "requested_model": {
      "enum": ["glm-5.3", "deepseek-v4-pro-0813", "gpt-5.6-sol"]
    },
    "reviewer_identity_sha256": {"$ref": "#/$defs/sha256"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_root_sha256": {"$ref": "#/$defs/sha256"},
    "calls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/call"}
    },
    "physical_call_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "provider_reported_call_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "missing_usage_call_count": {"const": 0},
    "mismatched_model_call_count": {"const": 0},
    "estimated_call_count": {"const": 0},
    "provider_usage_coverage": {"const": 1.0},
    "prompt_token_count": {"type": "integer", "minimum": 0},
    "completion_token_count": {"type": "integer", "minimum": 0},
    "total_token_count": {"type": "integer", "minimum": 0},
    "attribution_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial", "transport_retry", "contract_regeneration", "grounding_correction"
      ],
      "properties": {
        "initial": {"type": "integer", "minimum": 1},
        "transport_retry": {"type": "integer", "minimum": 0},
        "contract_regeneration": {"type": "integer", "minimum": 0},
        "grounding_correction": {"type": "integer", "minimum": 0}
      }
    },
    "call_conservation_passed": {"const": true},
    "token_conservation_passed": {"const": true},
    "included_in_balanced_scan_token_gate": {"const": false},
    "reviewer_usage_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence", "attribution", "provider", "requested_model", "observed_model_identity",
        "model_observation_source", "prompt_tokens", "completion_tokens",
        "total_tokens", "estimated", "physical_call", "provider_usage_reported",
        "input_sha256", "transport_stdout_sha256", "transport_stderr_sha256",
        "call_sha256"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 16},
        "attribution": {
          "enum": [
            "initial", "transport_retry", "contract_regeneration", "grounding_correction"
          ]
        },
        "provider": {"enum": ["claude-code", "deepseek", "openai"]},
        "requested_model": {
          "enum": ["glm-5.3", "deepseek-v4-pro-0813", "gpt-5.6-sol"]
        },
        "observed_model_identity": {
          "enum": ["glm-5.3", "deepseek-v4-pro-0813", "gpt-5.6-sol"]
        },
        "model_observation_source": {"enum": ["provider_reported", "sealed_command"]},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "estimated": {"const": false},
        "physical_call": {"const": true},
        "provider_usage_reported": {"const": true},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "transport_stdout_sha256": {"$ref": "#/$defs/sha256"},
        "transport_stderr_sha256": {"$ref": "#/$defs/sha256"},
        "call_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
