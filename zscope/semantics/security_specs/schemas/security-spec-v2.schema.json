{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/security-spec-v2.schema.json",
  "title": "SecuritySpec v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_revision", "spec_uid", "revision", "kind", "subject",
    "scope", "predicate", "parameters", "evidence_refs", "dependency_hashes", "origin",
    "confidence", "status", "conflicts", "supersedes", "qualification_ref", "review_ref",
    "explanation", "impact_preview", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.security-spec.v2"},
    "protocol_revision": {"const": 2},
    "spec_uid": {"type": "string", "pattern": "^SPEC_[0-9a-f]{32}$"},
    "revision": {"type": "integer", "minimum": 1},
    "kind": {"$ref": "#/$defs/predicate"},
    "predicate": {"$ref": "#/$defs/predicate"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "function_uid", "signature", "slot_uids"],
      "properties": {
        "language": {"enum": ["c_cpp", "java"]},
        "function_uid": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1},
        "slot_uids": {"type": "array", "items": {"$ref": "#/$defs/slot"}, "uniqueItems": true}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {"enum": ["project", "module", "file", "function", "callsite"]},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "parameters": {"type": "object"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dependency_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "origin": {"enum": ["program", "user_config", "llm", "qualification"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["observation", "proposed", "verified_scoped", "project_active", "stable", "conflicting", "rejected", "quarantined"]},
    "conflicts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "qualification_ref": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"},
    "review_ref": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"},
    "explanation": {"type": "string"},
    "impact_preview": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slot": {"type": "string", "pattern": "^(parameter:[0-9]+|return|receiver|field:[A-Za-z_][A-Za-z0-9_.:]*)$"},
    "predicate": {"enum": ["source", "sink", "propagate", "sanitize", "acquire", "release", "transfer", "lock", "unlock", "state_transition", "sentinel", "callback_retains", "caller_contract"]}
  }
}
