{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/evidence-action-v2.schema.json",
  "title": "EvidenceAction v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_revision", "action_uid", "obligation_uid", "clause_uid",
    "proof_ir_uid", "provider_family", "provider_id", "verifier_id", "predicate_id",
    "fact_kind", "quantifier", "subject_uid", "decision_region_uid", "fixed_parameters",
    "dependency_hashes", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.evidence-action.v2"},
    "protocol_revision": {"const": 2},
    "action_uid": {"type": "string", "pattern": "^EVACTION_[0-9a-f]{32}$"},
    "obligation_uid": {"type": "string", "pattern": "^POBL_[0-9a-f]{32}$"},
    "clause_uid": {"type": "string", "pattern": "^PCLAUSE_[0-9a-f]{32}$"},
    "proof_ir_uid": {"type": "string", "pattern": "^PROOFIR_[0-9a-f]{32}$"},
    "provider_family": {"enum": ["concurrency", "resource", "path_guard", "contract_type"]},
    "provider_id": {"type": "string", "minLength": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "predicate_id": {"type": "string", "minLength": 1},
    "fact_kind": {"type": "string", "minLength": 1},
    "quantifier": {"enum": ["must_at_point", "for_all_exits", "exists_path", "for_all_paths", "exact_binding", "exact_layout"]},
    "subject_uid": {"type": "string", "minLength": 1},
    "decision_region_uid": {"type": "string", "minLength": 1},
    "fixed_parameters": {"type": "object"},
    "dependency_hashes": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "minItems": 1, "uniqueItems": true},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
