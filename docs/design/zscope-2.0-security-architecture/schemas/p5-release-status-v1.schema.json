{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/p5-release-status-v1.json",
  "title": "Z-SCOPE P5 release status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "phase", "status", "reviewed_commit", "reviewed_tree",
    "qualification_manifest_sha256", "review_artifact_sha256", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.p5-release-status.v1"},
    "phase": {"const": "P5"},
    "status": {"enum": ["in_progress", "complete"]},
    "reviewed_commit": {"type": "string", "pattern": "^(|[0-9a-f]{40})$"},
    "reviewed_tree": {"type": "string", "pattern": "^(|[0-9a-f]{40})$"},
    "qualification_manifest_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "review_artifact_sha256": {
      "type": "object", "additionalProperties": false,
      "required": ["product_architecture", "proof_security"],
      "properties": {
        "product_architecture": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
        "proof_security": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
