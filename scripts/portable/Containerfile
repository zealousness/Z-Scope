ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN printf 'Acquire::Retries "5";\n' > /etc/apt/apt.conf.d/80-retries
RUN printf '%s\n' \
    'deb http://old-releases.ubuntu.com/ubuntu/ mantic main universe' \
    'deb http://old-releases.ubuntu.com/ubuntu/ mantic-updates main universe' \
    'deb http://old-releases.ubuntu.com/ubuntu/ mantic-security main universe' \
    > /etc/apt/sources.list && \
    apt-get -o Acquire::Check-Valid-Until=false -o APT::Update::Error-Mode=any update && \
    apt-get install -y --no-install-recommends \
      build-essential ninja-build cmake pkg-config git curl ca-certificates \
      patchelf binutils libssl-dev libffi-dev zlib1g-dev libbz2-dev liblzma-dev \
      libsqlite3-dev libreadline-dev libncurses-dev libgdbm-dev uuid-dev \
      libxml2-dev libz3-dev golang-go python3 python3-venv \
      unzip zip xz-utils zstd autoconf automake bison file && \
    test "$(getconf GNU_LIBC_VERSION)" = 'glibc 2.38' && \
    mkdir -p /opt/zscope-build-provenance && \
    dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\n' \
      > /opt/zscope-build-provenance/packages.tsv && \
    sha256sum /var/lib/apt/lists/*InRelease \
      > /opt/zscope-build-provenance/apt-metadata.sha256
RUN apt-get install -y --no-install-recommends libx11-6 libxext6 libxrender1 libxtst6 libxi6 libasound2 && \
    dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\n' \
      > /opt/zscope-build-provenance/packages.tsv
WORKDIR /work
