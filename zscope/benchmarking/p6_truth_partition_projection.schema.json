{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/p6-truth-partition-projection-v1.json",
  "title": "P6 post-score Truth v16 partition projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "truth_sha256",
    "product",
    "design_risk",
    "partitions_disjoint",
    "union_member_count",
    "union_member_commitments_sha256",
    "answer_material_present",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.p6-truth-partition-projection.v1"},
    "truth_sha256": {"$ref": "#/$defs/sha256"},
    "product": {"$ref": "#/$defs/partition"},
    "design_risk": {"$ref": "#/$defs/partition"},
    "partitions_disjoint": {"const": true},
    "union_member_count": {"const": 136},
    "union_member_commitments_sha256": {"$ref": "#/$defs/sha256"},
    "answer_material_present": {"const": false},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_count", "member_commitments", "member_commitments_sha256"],
      "properties": {
        "member_count": {"type": "integer", "minimum": 0},
        "member_commitments": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"},
          "uniqueItems": true
        },
        "member_commitments_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
