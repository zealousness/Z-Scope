{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/localized-coverage-key-v2.schema.json",
  "title": "LocalizedCoverageKey v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key_uid",
    "project_uid",
    "revision_uid",
    "function_uid",
    "defect_family",
    "subject_uid",
    "decision_region_uid",
    "structural_fingerprint_sha256",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.localized-coverage-key.v2"},
    "key_uid": {"type": "string", "pattern": "^LCK_[0-9a-f]{32}$"},
    "project_uid": {"type": "string", "minLength": 1},
    "revision_uid": {"type": "string", "minLength": 1},
    "function_uid": {"type": "string", "minLength": 1},
    "defect_family": {"type": "string", "minLength": 1},
    "subject_uid": {"type": "string", "minLength": 1},
    "decision_region_uid": {"type": "string", "minLength": 1},
    "structural_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
