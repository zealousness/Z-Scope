{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/hypothesis-offer-v2.schema.json",
  "title": "HypothesisOffer v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_revision",
    "offer_uid",
    "audit_unit_uid",
    "defect_family",
    "subject_uid",
    "decision_region_uid",
    "location",
    "source_ref",
    "sink_ref",
    "resource_ref",
    "proof_ir",
    "proof_obligation",
    "evidence_actions",
    "supporting_fact_refs",
    "opposing_fact_refs",
    "unknown_fact_refs",
    "evidence_refs",
    "dependency_hashes",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.hypothesis-offer.v2"},
    "protocol_revision": {"const": 2},
    "offer_uid": {"type": "string", "pattern": "^HOFFER_[0-9a-f]{32}$"},
    "audit_unit_uid": {"type": "string", "pattern": "^HAU_[0-9a-f]{32}$"},
    "defect_family": {"type": "string", "minLength": 1},
    "subject_uid": {"type": "string", "minLength": 1},
    "decision_region_uid": {"type": "string", "minLength": 1},
    "location": {"$ref": "#/$defs/location"},
    "source_ref": {"type": ["string", "null"]},
    "sink_ref": {"type": ["string", "null"]},
    "resource_ref": {"type": ["string", "null"]},
    "proof_ir": {"$ref": "program-proof-ir-v2.schema.json"},
    "proof_obligation": {"$ref": "proof-obligation-v2.schema.json"},
    "evidence_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "evidence-action-v2.schema.json"}
    },
    "supporting_fact_refs": {"$ref": "#/$defs/stringSet"},
    "opposing_fact_refs": {"$ref": "#/$defs/stringSet"},
    "unknown_fact_refs": {"$ref": "#/$defs/stringSet"},
    "evidence_refs": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"minItems": 1}]},
    "dependency_hashes": {"$ref": "#/$defs/hashSet"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "anyOf": [
        {"required": ["resource_ref"], "properties": {"resource_ref": {"type": "string", "minLength": 1}}},
        {
          "required": ["source_ref", "sink_ref"],
          "properties": {
            "source_ref": {"type": "string", "minLength": 1},
            "sink_ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  ],
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "function_uid", "start_line", "end_line", "statement_uid"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "function_uid": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "statement_uid": {"type": "string", "minLength": 1}
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hashSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
