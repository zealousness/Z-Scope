{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/p6_local_image_provenance.schema.json",
  "title": "Z-SCOPE P6 locally derived immutable toolchain image",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "git_revision", "platform", "base_image_ref",
    "base_image_digest", "runtime_lock_sha256", "containerfile_sha256",
    "python_requirements_sha256", "image_ref", "image_digest", "image_id",
    "toolchain_probe", "credential_material_present", "formal_evidence",
    "release_eligible", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.p6-local-image-provenance.v1"},
    "git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "platform": {"const": "linux/amd64"},
    "base_image_ref": {
      "const": "docker.io/library/python@sha256:de8ba566572ebcb35cbd10e03f5f351cad00a0d0d50a11e084f1a0fd24a0c41a"
    },
    "base_image_digest": {
      "const": "sha256:de8ba566572ebcb35cbd10e03f5f351cad00a0d0d50a11e084f1a0fd24a0c41a"
    },
    "runtime_lock_sha256": {"$ref": "#/$defs/sha256"},
    "containerfile_sha256": {"$ref": "#/$defs/sha256"},
    "python_requirements_sha256": {"$ref": "#/$defs/sha256"},
    "image_ref": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "image_id": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "toolchain_probe": {"$ref": "#/$defs/toolchainProbe"},
    "credential_material_present": {"const": false},
    "formal_evidence": {"const": false},
    "release_eligible": {"const": false},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "toolchainProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "required_tools", "paths", "versions",
        "missing_shared_libraries", "passed"
      ],
      "properties": {
        "schema_version": {"const": "zscope.p6-toolchain-probe.v1"},
        "required_tools": {
          "const": [
            "python3", "cmake", "gcc", "clang", "clangd", "gclang",
            "get-bc", "llvm-link", "llvm-nm", "wpa", "saber", "cc"
          ]
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python3", "cmake", "gcc", "clang", "clangd", "gclang",
            "get-bc", "llvm-link", "llvm-nm", "wpa", "saber", "cc"
          ],
          "properties": {
            "python3": {"$ref": "#/$defs/absolutePath"},
            "cmake": {"$ref": "#/$defs/absolutePath"},
            "gcc": {"$ref": "#/$defs/absolutePath"},
            "clang": {"$ref": "#/$defs/absolutePath"},
            "clangd": {"$ref": "#/$defs/absolutePath"},
            "gclang": {"$ref": "#/$defs/absolutePath"},
            "get-bc": {"$ref": "#/$defs/absolutePath"},
            "llvm-link": {"$ref": "#/$defs/absolutePath"},
            "llvm-nm": {"$ref": "#/$defs/absolutePath"},
            "wpa": {"$ref": "#/$defs/absolutePath"},
            "saber": {"$ref": "#/$defs/absolutePath"},
            "cc": {"$ref": "#/$defs/absolutePath"}
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python3", "cmake", "gcc", "clang", "clangd"],
          "properties": {
            "python3": {"$ref": "#/$defs/version"},
            "cmake": {"$ref": "#/$defs/version"},
            "gcc": {"$ref": "#/$defs/version"},
            "clang": {"$ref": "#/$defs/version"},
            "clangd": {"$ref": "#/$defs/version"}
          }
        },
        "missing_shared_libraries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wpa", "saber"],
          "properties": {
            "wpa": {"const": []},
            "saber": {"const": []}
          }
        },
        "passed": {"const": true}
      }
    },
    "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]+$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
