{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/p0-independent-review-v1.json",
  "title": "Z-SCOPE 2.0 P0 independent review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_schema",
    "role",
    "reviewer_model",
    "harness",
    "reviewed_commit",
    "reviewed_tree",
    "decision",
    "summary",
    "blocking_findings",
    "non_blocking_findings",
    "checks",
    "limitations",
    "attestation"
  ],
  "properties": {
    "review_schema": {"const": "zscope.p0-independent-review.v1"},
    "role": {
      "enum": ["product_architecture", "proof_security", "independent_benchmark"]
    },
    "reviewer_model": {"type": "string", "minLength": 1},
    "harness": {"type": "string", "minLength": 1},
    "reviewed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision": {"enum": ["approved", "changes_required", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "title", "evidence", "required_action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "title": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "required_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "non_blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "evidence", "recommendation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "not_verified"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "attestation": {"type": "string", "minLength": 1}
  }
}
