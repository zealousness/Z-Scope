{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zscope.document-section.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "section_id",
    "source_id",
    "heading_path",
    "heading_level",
    "start_line",
    "end_line",
    "text_digest",
    "excerpt",
    "symbols",
    "module_hints",
    "normative_terms",
    "link_targets"
  ],
  "properties": {
    "schema_version": {
      "const": "zscope.document-section.v1"
    },
    "section_id": {
      "type": "string",
      "pattern": "^docsec_[a-z0-9_:-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^docsrc_[a-z0-9_:-]+$"
    },
    "heading_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "heading_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "start_line": {
      "type": "integer",
      "minimum": 1
    },
    "end_line": {
      "type": "integer",
      "minimum": 1
    },
    "text_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "excerpt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "symbols": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "module_hints": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^module:[a-z0-9_.:/-]+$"
      }
    },
    "normative_terms": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "must",
          "must_not",
          "shall",
          "shall_not",
          "required",
          "only",
          "should",
          "recommended",
          "range",
          "ownership",
          "lock",
          "error"
        ]
      }
    },
    "link_targets": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "fragment_index": {
      "type": "integer",
      "minimum": 0
    },
    "fragment_count": {
      "type": "integer",
      "minimum": 1
    },
    "char_start": {
      "type": "integer",
      "minimum": 0
    },
    "char_end": {
      "type": "integer",
      "minimum": 1
    }
  }
}
