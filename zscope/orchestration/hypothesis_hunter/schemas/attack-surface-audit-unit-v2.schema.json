{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/attack-surface-audit-unit-v2.schema.json",
  "title": "AttackSurfaceAuditUnit v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_revision",
    "audit_unit_uid",
    "unit_fingerprint_sha256",
    "project_uid",
    "revision_uid",
    "risk_score",
    "trigger_kinds",
    "localized_coverage_key",
    "root_entry_uids",
    "member_function_uids",
    "event_refs",
    "security_spec_refs",
    "unknown_refs",
    "dependency_hashes",
    "backend_coverage",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.attack-surface-audit-unit.v2"},
    "protocol_revision": {"const": 2},
    "audit_unit_uid": {"type": "string", "pattern": "^HAU_[0-9a-f]{32}$"},
    "unit_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_uid": {"type": "string", "minLength": 1},
    "revision_uid": {"type": "string", "minLength": 1},
    "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "trigger_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "external_reachable_sensitive",
          "security_spec_unknown",
          "security_spec_conflict",
          "dynamic_call_gap",
          "backend_coverage_gap",
          "localized_candidate_desert"
        ]
      }
    },
    "localized_coverage_key": {"$ref": "localized-coverage-key-v2.schema.json"},
    "root_entry_uids": {"$ref": "#/$defs/stringSet"},
    "member_function_uids": {"allOf": [{"$ref": "#/$defs/stringSet"}, {"minItems": 1}]},
    "event_refs": {"$ref": "#/$defs/stringSet"},
    "security_spec_refs": {"$ref": "#/$defs/stringSet"},
    "unknown_refs": {"$ref": "#/$defs/stringSet"},
    "dependency_hashes": {"$ref": "#/$defs/hashSet"},
    "backend_coverage": {"type": "object"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hashSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
