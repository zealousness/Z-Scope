{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/hypothesis-coverage-observation-v1.schema.json",
  "title": "HypothesisCoverageObservation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_uid",
    "audit_unit_uid",
    "unit_fingerprint_sha256",
    "reason_code",
    "missing_fields",
    "evidence_refs",
    "dependency_hashes",
    "producer",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.hypothesis-coverage-observation.v1"},
    "observation_uid": {"type": "string", "pattern": "^HOBS_[0-9a-f]{32}$"},
    "audit_unit_uid": {"type": "string", "pattern": "^HAU_[0-9a-f]{32}$"},
    "unit_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason_code": {"type": "string", "minLength": 1},
    "missing_fields": {"$ref": "#/$defs/stringSet"},
    "evidence_refs": {"$ref": "#/$defs/stringSet"},
    "dependency_hashes": {"$ref": "#/$defs/hashSet"},
    "producer": {"const": "hypothesis_hunter"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hashSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
