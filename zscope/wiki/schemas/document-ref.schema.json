{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zscope.document-ref.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ref_id",
    "source_id",
    "relative_path",
    "heading_path",
    "start_line",
    "end_line",
    "source_digest",
    "excerpt_digest",
    "resolvable"
  ],
  "properties": {
    "schema_version": {
      "const": "zscope.document-ref.v1"
    },
    "ref_id": {
      "type": "string",
      "pattern": "^docref_[a-z0-9_:-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^docsrc_[a-z0-9_:-]+$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?:[^/]+/)*[^/]+$"
    },
    "heading_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "start_line": {
      "type": "integer",
      "minimum": 1
    },
    "end_line": {
      "type": "integer",
      "minimum": 1
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "excerpt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resolvable": {
      "type": "boolean"
    },
    "excerpt": {
      "type": "string",
      "maxLength": 8192
    },
    "fragment_index": {
      "type": "integer",
      "minimum": 0
    },
    "fragment_count": {
      "type": "integer",
      "minimum": 1
    },
    "char_start": {
      "type": "integer",
      "minimum": 0
    },
    "char_end": {
      "type": "integer",
      "minimum": 1
    }
  }
}
