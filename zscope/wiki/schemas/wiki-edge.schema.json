{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zscope.wiki-edge.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edge_id",
    "from_id",
    "edge_type",
    "to_id",
    "source_refs",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "zscope.wiki-edge.v1"
    },
    "edge_id": {
      "type": "string",
      "pattern": "^wikiedge_[a-z0-9_:-]+$"
    },
    "from_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "edge_type": {
      "type": "string",
      "enum": [
        "documents",
        "owns",
        "depends_on",
        "calls",
        "acquires",
        "releases",
        "protects",
        "constrains",
        "conflicts_with"
      ]
    },
    "to_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^docref_[a-z0-9_:-]+$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stale",
        "conflicted",
        "retired"
      ]
    }
  }
}
