{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/security-spec-archive-v2.schema.json",
  "title": "SecuritySpec Archive v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "store_revision", "specs", "reviews", "qualifications", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": "zscope.security-spec-archive.v2"}, "mode": {"const": "read_only"},
    "store_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "specs": {"type": "array", "items": {"type": "object"}}, "reviews": {"type": "array", "items": {"type": "object"}},
    "qualifications": {"type": "array", "items": {"type": "object"}},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
