{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.local/schemas/runtime-authority-manifest-v1.schema.json",
  "title": "RuntimeAuthorityManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_revision", "cache_epoch", "source_tree_hash",
    "config_sha256", "backend_sha256", "artifact_roots", "modes", "revisions",
    "decision_trace_schema", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.runtime-authority-manifest.v1"},
    "protocol_revision": {"const": 1},
    "cache_epoch": {"const": "zscope.runtime-authority.p5"},
    "source_tree_hash": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_roots": {
      "type": "object", "additionalProperties": false,
      "required": ["security_spec", "hypothesis_hunter", "proof_engine"],
      "properties": {
        "security_spec": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"},
        "hypothesis_hunter": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"},
        "proof_engine": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"}
      }
    },
    "modes": {
      "const": {
        "security_spec": "authoritative",
        "hypothesis_hunter": "active",
        "hypothesis_hunter_effect": "candidate_registration_only",
        "proof_engine": "authoritative"
      }
    },
    "revisions": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "decision_trace_schema": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
