{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zscope.dev/schemas/p6-sidecar-evidence-v1.json",
  "title": "P6 answer-free decision-trace sidecar evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_trace_manifest_path",
    "decision_trace_manifest_sha256",
    "member_count",
    "members_sha256",
    "trace_count",
    "coverage_trace_count",
    "evidence_object_count",
    "model_event_count",
    "members",
    "answer_material_present",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "zscope.p6-trace-sidecar-evidence.v1"},
    "decision_trace_manifest_path": {
      "type": "string",
      "pattern": "^[^./\\\\][^/\\\\]*\\.json$"
    },
    "decision_trace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "member_count": {"type": "integer", "minimum": 1},
    "members_sha256": {"$ref": "#/$defs/sha256"},
    "trace_count": {"type": "integer", "minimum": 0},
    "coverage_trace_count": {"type": "integer", "minimum": 0},
    "evidence_object_count": {"type": "integer", "minimum": 0},
    "model_event_count": {"type": "integer", "minimum": 0},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "payload_base64"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size": {"type": "integer", "minimum": 0, "maximum": 536870912},
          "payload_base64": {"type": "string"}
        }
      }
    },
    "answer_material_present": {"const": false},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
